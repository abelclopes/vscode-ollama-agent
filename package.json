{
  "name": "vscode-ollama-agent",
  "displayName": "Ollama Chat Agent",
  "description": "Chat com modelos Ollama na sua rede local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ollama-sidebar",
          "title": "Ollama Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ollama-sidebar": [
        {
          "type": "webview",
          "id": "ollamaChat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Ollama Agent",
      "properties": {
        "ollamaAgent.serverUrl": {
          "type": "string",
          "default": "http://192.168.1.86:11434"
        },
        "ollamaAgent.model": {
          "type": "string",
          "default": "qwen2.5-coder:latest"
        },
        "ollamaAgent.temperature": {
          "type": "number",
          "default": 0.7
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}