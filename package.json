{
  "name": "vscode-ollama-agent",
  "displayName": "Ollama Chat Agent",
  "description": "Chat com modelos Ollama na sua rede local - Agente de código com capacidade de criar, ler e deletar arquivos",
  "version": "0.2.0",
  "publisher": "abellopes",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abellopes/vscode-ollama-agent"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ollama",
    "ai",
    "chat",
    "llama",
    "code assistant",
    "agent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ollama-sidebar",
          "title": "Ollama Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ollama-sidebar": [
        {
          "type": "webview",
          "id": "ollamaChat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Ollama Agent",
      "properties": {
        "ollamaAgent.serverUrl": {
          "type": "string",
          "default": "http://192.168.1.86:11434"
        },
        "ollamaAgent.model": {
          "type": "string",
          "default": "qwen2.5-coder:latest"
        },
        "ollamaAgent.temperature": {
          "type": "number",
          "default": 0.7
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}